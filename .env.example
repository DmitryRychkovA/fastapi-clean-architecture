# App
APP_ENV=local
DEBUG=true
PROJECT_NAME=Medical Study Metadata API

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/medical_db

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBIT_POOL_SIZE=2
RABBIT_CHANNEL_POOL_SIZE=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=3600
